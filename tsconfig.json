{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "strict": false,
    "skipLibCheck": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "paths": {
      "*": ["./*", "./assets/scripts/*"]
    }
  },
  "include": [
    "assets/scripts/**/*.ts"
  ]
}
